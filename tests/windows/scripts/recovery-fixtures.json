    {
      "name": "no record, marker says on",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":true,\"hotel_saved_killswitch\":\"on\"}",
      "expect": "restore:on"
    },
    {
      "name": "no record, marker says auto",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":true,\"hotel_saved_killswitch\":\"auto\"}",
      "expect": "restore:auto"
    },
    {
      "name": "no record, marker with invalid value",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":true,\"hotel_saved_killswitch\":\"bogus\"}",
      "expect": "unknown"
    },
    {
      "name": "no record, marker with empty value",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":true,\"hotel_saved_killswitch\":\"\"}",
      "expect": "unknown"
    },
    {
      "name": "no record, marker as text",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"hotel_active\":\"true\",\"hotel_saved_killswitch\":\"on\"}",
      "expect": "unknown"
    },
    {
      "name": "no record, saved value as number",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"hotel_active\":true,\"hotel_saved_killswitch\":1}",
      "expect": "unknown"
    },
    {
      "name": "no record, no hotel login",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":false,\"hotel_saved_killswitch\":\"\"}",
      "expect": "none"
    },
    {
      "name": "no record, older guard.json without hotel fields",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "none"
    },
    {
      "name": "no record, guard.json missing",
      "record": null,
      "guard": null,
      "expect": "unknown"
    },
    {
      "name": "no record, guard.json damaged",
      "record": null,
      "guard": "{\"mode\":\"st",
      "expect": "unknown"
    },
    {
      "name": "no record, guard.json is an array",
      "record": null,
      "guard": "[]",
      "expect": "unknown"
    },
    {
      "name": "duplicate field",
      "record": "{\"version\":1,\"hotel\":3,\"hotel\":4,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\"}",
      "expect": "unknown"
    },
    {
      "name": "duplicate kill switch field",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"auto\",\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\"}",
      "expect": "unknown"
    },
    {
      "name": "same field in other capitals",
      "record": "{\"version\":1,\"hotel\":3,\"Hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\"}",
      "expect": "unknown"
    },
    {
      "name": "escape codes in a field name",
      "record": "{\"version\":1,\"hot\\u0065l\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\"}",
      "expect": "unknown"
    },
    {
      "name": "record too big",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\"}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ",
