{
  "about": "Hotel recovery record cases (including duplicate / case-colliding / escaped field names, review V60-11). pialite-guard (config.rs test recovery_fixtures_agree) and the uninstaller's PowerShell reader (PiaLite-Common.ps1, checked by Phase5-Tests.ps1 quick checks) must both give 'expect'. record/guard = the exact text of hotel-recovery.json / guard.json, null = file missing. Expect: none | restore:<value> | unknown (unknown = the uninstaller asks you to check PIA yourself; the guard assumes 'on').",
  "cases": [
    {
      "name": "valid, was on",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":true,\"hotel_saved_killswitch\":\"on\"}",
      "expect": "restore:on"
    },
    {
      "name": "valid, was auto",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"auto\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "restore:auto"
    },
    {
      "name": "valid, was off",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"off\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "restore:off"
    },
    {
      "name": "v0.5 record without version",
      "record": "{\"hotel\":2,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "restore:on"
    },
    {
      "name": "record valid, guard.json missing",
      "record": "{\"version\":1,\"hotel\":1,\"saved_killswitch\":\"on\"}",
      "guard": null,
      "expect": "restore:on"
    },
    {
      "name": "record valid, guard.json damaged",
      "record": "{\"version\":1,\"hotel\":1,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":",
      "expect": "restore:on"
    },
    {
      "name": "unknown version",
      "record": "{\"version\":2,\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "version null",
      "record": "{\"version\":null,\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "version as text",
      "record": "{\"version\":\"1\",\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "invalid kill switch value",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"bogus\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "empty kill switch value",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "kill switch null",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":null}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "kill switch missing",
      "record": "{\"version\":1,\"hotel\":3}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "kill switch upper case",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"ON\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "kill switch as number",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":1}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "hotel zero",
      "record": "{\"version\":1,\"hotel\":0,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "hotel negative",
      "record": "{\"version\":1,\"hotel\":-1,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "hotel as text",
      "record": "{\"version\":1,\"hotel\":\"3\",\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "hotel fraction",
      "record": "{\"version\":1,\"hotel\":1.5,\"saved_killswitch\":\"on\"}",
