      "expect": "unknown"
    },
    {
      "name": "record, guard.json marker already cleared",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\",\"hotel_active\":false,\"hotel_saved_killswitch\":\"\"}",
