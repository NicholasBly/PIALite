      "expect": "unknown"
    },
    {
      "name": "hotel too big",
      "record": "{\"version\":1,\"hotel\":9007199254740992,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "hotel missing",
      "record": "{\"version\":1,\"saved_killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "extra field",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\",\"note\":\"x\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "field name in other case",
      "record": "{\"version\":1,\"hotel\":3,\"Saved_Killswitch\":\"on\"}",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "corrupt JSON",
      "record": "{\"version\":1,\"hot",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "empty file",
      "record": "",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "JSON array",
      "record": "[]",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "JSON null",
      "record": "null",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "JSON text",
      "record": "\"on\"",
      "guard": "{\"mode\":\"startup\",\"profile_id\":\"abc123\"}",
      "expect": "unknown"
    },
    {
      "name": "record and guard.json disagree",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\"}",
