      "expect": "unknown"
    },
    {
      "name": "no record, hotel_active twice",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"hotel_active\":false,\"hotel_active\":true,\"hotel_saved_killswitch\":\"on\"}",
      "expect": "unknown"
    },
    {
      "name": "no record, hotel_active in other capitals",
      "record": null,
      "guard": "{\"mode\":\"startup\",\"hotel_active\":true,\"Hotel_Active\":false,\"hotel_saved_killswitch\":\"on\"}",
      "expect": "unknown"
    },
    {
      "name": "record valid, guard.json has a duplicate",
      "record": "{\"version\":1,\"hotel\":3,\"saved_killswitch\":\"on\"}",
      "guard": "{\"hotel_active\":true,\"hotel_active\":true}",
      "expect": "restore:on"
    }
  ]
}
